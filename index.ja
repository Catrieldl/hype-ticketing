const express = require('express');
const cors = require('cors');

const app = express();
app.use(cors());
app.use(express.json()); // Permite leer los JSON que manda Nave

const PORT = process.env.PORT || 3000;

// Ruta principal de prueba
app.get('/', (req, res) => {
  res.send('El servidor de entradas para Hollywood está online 🚀');
});

// Endpoint para el Webhook de Nave
app.post('/api/webhooks/nave', (req, res) => {
  console.log('Notificación de pago recibida:', req.body);
  // Nave exige que se le responda con 200 OK
  res.status(200).send('OK');
});

app.listen(PORT, () => {
  console.log(`Servidor corriendo en el puerto ${PORT}`);
});
